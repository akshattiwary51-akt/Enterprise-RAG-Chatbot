# Copy to backend/.env and fill in. NEVER commit the real file.
APP_ENV=development                  # development | production | testing

# --- Secrets (>= 32 chars, different from each other). Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-value
JWT_SECRET_KEY=change-me-generate-a-different-long-random-value

# --- Database (required in production; SQLite fallback in development)
DATABASE_URL=postgresql+psycopg2://ragapp:change-me@localhost:5432/ragapp

# --- Models
EMBEDDINGS_PROVIDER=openai           # openai | fake (fake = dev/test only)
EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=openai                  # openai | fake
CHAT_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=

# --- Vector store
VECTOR_BACKEND=chroma                # chroma | pinecone
# PINECONE_API_KEY=your-pinecone-api-key
# PINECONE_INDEX=your-index-name
# PINECONE_NAMESPACE=enterprise-docs

# --- Web
CORS_ORIGINS=http://localhost:5173   # comma-separated allowlist; no wildcard in production
TRUSTED_PROXY_COUNT=0                # number of reverse proxies in front (for correct client IPs / rate limits)
MAX_UPLOAD_MB=25
LOGIN_RATE_LIMIT=10 per minute
# RATELIMIT_STORAGE_URI=redis://redis:6379/0   # use a shared store when running several workers

# --- RAG tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=6
SIMILARITY_THRESHOLD=0.25

# --- Retention
CHAT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365

# --- Auth lifetime
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
